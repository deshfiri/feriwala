* text=auto eol=lf

# Fonts are binary: never let a line-ending rule touch their bytes.
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary

*.blade.php diff=html
*.css diff=css
*.html diff=html
*.md diff=markdown
*.php diff=php

CHANGELOG.md export-ignore
README.md export-ignore
.github/workflows/browser-tests.yml export-ignore
