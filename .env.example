APP_NAME=Feriwala
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Dhaka
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# A reset link is a password sitting in a mailbox (§6). Minutes it stays usable,
# and seconds before another may be requested for the same address.
AUTH_PASSWORD_RESET_EXPIRE=60
AUTH_PASSWORD_RESET_THROTTLE=60

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL is required (requirements.txt §2, §37). Do not switch to SQLite/MySQL.
# Hosts assume native services in WSL (decision D5, amended). If you run the
# containers in compose.yaml instead, override DB_HOST=pgsql and REDIS_HOST=redis.
# Tests use the `testing` schema in this same database — see phpunit.xml.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=feriwala
DB_USERNAME=feriwala
DB_PASSWORD=secret

# Redis carries cache, sessions, queues, rate limiting, temp tokens and locks (§38).
# The app must stay stateless and horizontally scalable (§40) — never revert these to
# `file` or `database` drivers.
SESSION_DRIVER=redis
# The deployed floor. `security.session_lifetime_minutes` in the settings table
# overrides it at runtime when set (§36); this is what applies when it is not.
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SAME_SITE=lax
# Sessions get their own Redis database so `cache:clear` cannot sign everyone out.
SESSION_CONNECTION=session
# Left unset locally: `php artisan serve` is plain HTTP, and a Secure cookie
# would never come back. Production derives it from APP_ENV and sets it on.
# SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=
# Login attempt limits are counted here. Redis rather than the local node, or
# every extra web server silently multiplies the number of guesses allowed (§6).
CACHE_LIMITER=redis

# predis is a pure-PHP client; the phpredis extension is not installed here.
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE_DB=2
REDIS_LOCK_DB=3
REDIS_SESSION_DB=4
REDIS_QUEUE_CONNECTION=queue
REDIS_CACHE_LOCK_CONNECTION=locks

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@feriwala.test"
MAIL_FROM_NAME="${APP_NAME}"

# S3-compatible object storage — required so no persistent files live on the app server (§40, D10).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
