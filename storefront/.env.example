# --- The shop -------------------------------------------------------------
APP_NAME="My Shop"
# The public address of this storefront, no trailing slash. Must be https in
# production: it is what the ERP sends customers back to after paying.
APP_URL=https://shop.example.com
APP_ENV=production
APP_DEBUG=false
# Set to 1 only when a proxy / load balancer you control sits in front of this
# (then X-Forwarded-For and X-Forwarded-Proto are believed).
TRUSTED_PROXY=0

# --- MySQL ----------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=storefront
DB_USER=storefront
DB_PASS=
# DB_SOCKET=/var/run/mysqld/mysqld.sock

# --- The Feriwala ERP -----------------------------------------------------
# Three lines connect this store. Platform staff create them in the ERP's
# admin dashboard (Websites > the partner's website > Connect the store):
# give the store's address, and copy what it shows back.
ERP_BASE_URL=https://erp.example.com
STORE_ID=wsk_XXXXXXXXXXXXXXXXXXXXXXXXXX
STORE_TOKEN=
# Only when one deployment serves several websites: the host this one is.
# ERP_STOREFRONT_HOST=shop.example.com
ERP_TIMEOUT=10

# --- Webhooks (optional) -------------------------------------------------------
# Set when the dashboard registered a webhook for this store (it shows the
# secret). Without it the catalogue simply refreshes as its cache expires.
# The endpoint is  APP_URL/webhooks/feriwala
WEBHOOK_SECRET=
# During a secret rotation, the one being retired.
WEBHOOK_SECRET_PREVIOUS=

# --- Cache lifetimes, in seconds -------------------------------------------
CACHE_TTL_SITE=300
CACHE_TTL_CATALOG=60
CACHE_TTL_PRODUCT=120
CACHE_TTL_CATEGORIES=600

# --- Local development only -----------------------------------------------
# ERP_INSECURE_TLS=1   (needs APP_ENV=local; skips certificate verification)
